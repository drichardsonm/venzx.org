# --- Supabase en Docker (mismo servidor: usa la dirección local, no el túnel) ---
SUPABASE_URL=http://localhost:8000
SUPABASE_SERVICE_ROLE_KEY=pega-aqui-tu-service-role-key
SUPABASE_PUBLISHABLE_KEY=pega-aqui-tu-anon-key
# Estas se "hornean" en el navegador al compilar.
# OBLIGATORIO: la URL pública HTTPS del túnel (https://supabase.tudominio.com).
# NUNCA localhost ni 192.168.x.x aquí: el navegador del visitante las resolvería
# en su propio teléfono y Android mostraría el aviso "quiere acceder a otros
# servicios y apps en este dispositivo". Tras cambiarla, recompila (npm run build).
VITE_SUPABASE_URL=https://supabase.tudominio.com
VITE_SUPABASE_PUBLISHABLE_KEY=pega-aqui-tu-anon-key
VITE_SUPABASE_PROJECT_ID=selfhosted

# --- Ollama a través de Cloudflare Tunnel ---
OLLAMA_BASE_URL=https://ollama.tudominio.com
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_MS=45000
# Token de servicio de Cloudflare Zero Trust (Access > Service Auth)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# --- Servidor Node ---
PORT=3000
HOST=127.0.0.1
